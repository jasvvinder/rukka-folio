  "recovery.fork.other_phone.body": "Hold the two phones together for a minute. Nobody else has to do anything.",
  "@recovery.fork.other_phone.body": {"description": "S11.6 row 1 one-line explanation — the link ceremony (04 §9.1), stated as what the user does, not what the protocol does."},
  "recovery.fork.trusted.title": "Ask your trusted members",
