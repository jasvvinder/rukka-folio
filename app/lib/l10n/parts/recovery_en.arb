  "@recovery.nothing.title": {"description": "S11.8 heading 🔒 — fixed word for word by DESIGN-PACK R2.5. The whole screen is built around 'yet'. Only the apostrophe follows house typography (’, as every other string here does)."},
  "recovery.nothing.family.title": "Your family and business books",
