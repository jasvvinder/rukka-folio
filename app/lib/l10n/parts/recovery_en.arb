  "recovery.silent.failed": "This phone’s key store had nothing for us.",
  "@recovery.silent.failed": {"description": "S11.5 failure: rung 0 found no key (04 §7.0 limits — different Apple/Google account, or the user turned key sync off). Plain, never alarming; the next line offers the ladder."},
  "recovery.silent.failed.action": "Get your books back another way",
  "@recovery.silent.failed.action": {"description": "S11.5 failure action → S11.6, the fork. No dead ends (07 §1 rule 6)."},
  "recovery.fork.title": "Let’s get your books back on this phone",
