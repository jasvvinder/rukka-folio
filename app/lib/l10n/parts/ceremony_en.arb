{
  "@@locale": "en",

  "ceremony.show.title": "Show my code",
  "@ceremony.show.title": {"description": "S9.2 title (13 §3.2, 07 §12) — the invitee's side of the ceremony."},
  "ceremony.show.body": "Let them scan this square. If they can’t, read the eight digits out to them.",
  "@ceremony.show.body": {"description": "S9.2 lead line. Both paths are equal (design-system §3.1 rule 7 — camera-free path)."},
  "ceremony.show.qr.semantics": "Your verification square. The same code is written below as eight digits.",
  "@ceremony.show.qr.semantics": {"description": "S9.2 QR semantics label — a screen reader can never read the square, so it is told the digits are the equal alternative."},
  "ceremony.show.code.label": "Your 8-digit code",
  "@ceremony.show.code.label": {"description": "S9.2 label above the eight character boxes (07 §12 🔒 owner-approved)."},
  "ceremony.show.code.semantics": "Your 8-digit code: {digits}",
  "@ceremony.show.code.semantics": {"description": "S9.2 spoken form of the eight boxes — the boxes are presentation, the digits are read as one code.", "placeholders": {"digits": {"type": "String"}}},
  "ceremony.show.waiting.title": "Waiting for {name} to enter the code",
  "@ceremony.show.waiting.title": {"description": "S9.2 waiting state 🔒 (ADR 2026-09-13d §5, ratified 13 Sep 2026). The eight boxes stand empty because the digits do not yet exist: they are derived from this phone's r_S and the verifier's r_V together, and r_V is drawn only when the verifier begins. Not an error and not a delay to apologise for — copy is the 07/13 design owner's to settle.", "placeholders": {"name": {"type": "String"}}},
  "ceremony.show.waiting.why": "The digits appear the moment they begin. They can scan the square now instead.",
  "@ceremony.show.waiting.why": {"description": "S9.2 waiting state, the muted line beneath: says what will happen and names the faster path, so waiting is never a dead end (07 §1 rule 6). The QR works throughout — it never waits for anyone."},
  "ceremony.show.waiting.semantics": "Your 8-digit code is not ready yet. Waiting for {name} to enter it.",
  "@ceremony.show.waiting.semantics": {"description": "S9.2 spoken form of the empty boxes while waiting — a screen reader hears why they are empty rather than eight blanks.", "placeholders": {"name": {"type": "String"}}},
  "ceremony.show.expires_in": "Expires in {time}",
  "@ceremony.show.expires_in": {"description": "S9.2 visible expiry countdown beside the code (07 §12 🔒). Nonce lifetime is 10 minutes (04 §6.3).", "placeholders": {"time": {"type": "String"}}},
  "ceremony.show.expired": "This code has expired.",
  "@ceremony.show.expired": {"description": "S9.2 expired state — the nonce is past 04 §6.3's ten minutes."},
  "ceremony.show.regenerate": "Get a new code",
  "@ceremony.show.regenerate": {"description": "S9.2 action: Regenerate issues a fresh nonce (04 §6.3). The one next step from the expired state."},
  "ceremony.show.channel_rule": "Never send this code in a message. Say it out loud on a call, or let them scan the square.",
  "@ceremony.show.channel_rule": {"description": "S9.2 standing line explaining why there is no share button (04 §6.4 channel rule 🔒). Never soften."},
  "ceremony.show.loading": "Getting your code.",
  "@ceremony.show.loading": {"description": "S9.2 loading state (13 §4.3). A verb, never a percentage (11 §4.5)."},
  "ceremony.show.error": "Couldn’t get your code.",
  "@ceremony.show.error": {"description": "S9.2 error state (13 §4.3 error-with-retry)."},
  "ceremony.show.retry": "Try again",
  "@ceremony.show.retry": {"description": "Retry action on the S9.2 / S9.3 error states."},
  "ceremony.show.offline": "Offline — this code still works face to face.",
  "@ceremony.show.offline": {"description": "S9.2 quiet offline chip (07 §1 rule 7). The code is derived on this phone, so it keeps working."},
  "ceremony.show.time.minutes_seconds": "{minutes} min {seconds} s",
  "@ceremony.show.time.minutes_seconds": {"description": "S9.2 countdown format above one minute. Latin digits, tabular figures.", "placeholders": {"minutes": {"type": "int"}, "seconds": {"type": "int"}}},
  "ceremony.show.time.seconds": "{seconds} s",
  "@ceremony.show.time.seconds": {"description": "S9.2 countdown format under one minute.", "placeholders": {"seconds": {"type": "int"}}},

  "ceremony.verify.title": "Verify member",
  "@ceremony.verify.title": {"description": "S9.3 title (13 §3.2, 07 §12) — the verifier's side. Any active member may do this (04 §6.4, delegated)."},
  "ceremony.verify.camera.hint": "Point the camera at the square on their phone.",
  "@ceremony.verify.camera.hint": {"description": "S9.3 camera state — camera is open by default (04 §6.2)."},
  "ceremony.verify.camera.enter_code": "Enter code instead",
  "@ceremony.verify.camera.enter_code": {"description": "S9.3 button, always present (04 §6.2 🔒, design-system §3.1 rule 7). A blind user or a broken camera must never block joining."},
  "ceremony.verify.camera.unavailable": "The camera isn’t available on this phone. Type their eight digits instead.",
  "@ceremony.verify.camera.unavailable": {"description": "S9.3 camera-unavailable state — no dead end (07 §1 rule 6); the code path takes over."},
  "ceremony.verify.camera.denied": "This app hasn’t been given the camera. Type their eight digits instead.",
  "@ceremony.verify.camera.denied": {"description": "S9.3 permission-denied state — the code path takes over, never a wall."},
  "ceremony.verify.scan.not_a_code": "That isn’t a verification square. Ask them to open Show my code.",
  "@ceremony.verify.scan.not_a_code": {"description": "S9.3 state when the camera read some other QR (a shop's payment square, say). NOT a mismatch — nothing is compared and nothing is logged; 04 §6.3's hard fail is only for a real ceremony payload whose keys differ."},
  "ceremony.verify.code.label": "Their 8-digit code",
  "@ceremony.verify.code.label": {"description": "S9.3 code-entry label."},
  "ceremony.verify.code.hint": "Ask them to read it out from their phone.",
  "@ceremony.verify.code.hint": {"description": "S9.3 code-entry hint — the code originates on the invitee's device (04 §6.4)."},
  "ceremony.verify.code.preparing": "Getting ready for their code.",
  "@ceremony.verify.code.preparing": {"description": "S9.3 loading state while the code path is armed (04 §6.3, ADR 2026-09-13d §1): this device holds the relayed key and commitment, draws its own contribution, relays it and waits for the opening. A verb, never a percentage (11 §4.5)."},
  "ceremony.verify.code.why_hidden": "This phone never shows their code. Typing what they read out is the check.",
  "@ceremony.verify.code.why_hidden": {"description": "S9.3 muted line under the entry boxes 🔒 (ADR 2026-09-13d §5): the verifier's device never displays the digits it expects. Says why the number is not on screen, so its absence reads as design rather than as something missing. Never soften into offering to show it."},
  "ceremony.verify.code.use_camera": "Use the camera instead",
  "@ceremony.verify.code.use_camera": {"description": "S9.3 way back to the camera from the code path — both paths are equal."},
  "ceremony.verify.check": "Check code",
  "@ceremony.verify.check": {"description": "S9.3 primary action on the code path."},
  "ceremony.verify.checking": "Checking.",
  "@ceremony.verify.checking": {"description": "S9.3 loading state while the code is compared (13 §4.3)."},
  "ceremony.verify.wrong": "Those digits don’t match. {left, plural, =1{1 try left.} other{{left} tries left.}}",
  "@ceremony.verify.wrong": {"description": "S9.3 wrong-code state — 3 attempts per nonce (04 §6.3). Not a mismatch: a mis-typed code is a slip, not an attack.", "placeholders": {"left": {"type": "int"}}},
  "ceremony.verify.expired": "That code has expired. Ask them to get a new one on their phone.",
  "@ceremony.verify.expired": {"description": "S9.3 expired-nonce state (04 §6.3, ten minutes) — with the one next step."},
  "ceremony.verify.exhausted": "That code is used up. Ask them to get a new one on their phone.",
  "@ceremony.verify.exhausted": {"description": "S9.3 dead-nonce state — three wrong tries, or already verified (04 §6.3)."},
  "ceremony.verify.error": "Couldn’t check that just now.",
  "@ceremony.verify.error": {"description": "S9.3 error state (13 §4.3 error-with-retry). Never shows a raw code (07 §1 rule 12)."},
  "ceremony.verify.offline": "Offline — checking needs a connection. Try again when you’re back.",
  "@ceremony.verify.offline": {"description": "S9.3 offline state: the keys being compared are server-relayed (04 §6.3), so this one check truly needs the network. States the path back (07 §1 rule 6)."},
  "ceremony.verify.remote.instruction": "Call them and ask them to read the code aloud.",
  "@ceremony.verify.remote.instruction": {"description": "S9.3 remote mode, exact wording 🔒 (04 §6.4, 07 §12). There is no share button on this screen, by design."},
  "ceremony.verify.remote.why": "A voice or video call only. A text message would hand the code to exactly the person this check exists to stop.",
  "@ceremony.verify.remote.why": {"description": "S9.3 remote-mode explanation of the channel rule (04 §6.4 🔒). Never soften."},
  "ceremony.verify.read_only": "Only an active, verified member can verify someone. Ask one of them to do it.",
  "@ceremony.verify.read_only": {"description": "S9.3 read-only variant (13 §2.3.1, S12.5 pattern): this member may not run the ceremony — with the way forward."},
  "ceremony.verify.success.title": "Verified",
  "@ceremony.verify.success.title": {"description": "S9.3 success state — green tick, restrained (07 §12). The word carries the meaning; the colour never alone (07 §1 rule 3)."},
  "ceremony.verify.success.body": "{name} is confirmed. Their shared books open now.",
  "@ceremony.verify.success.body": {"description": "S9.3 success line. The member's name is user-typed — carries its own lang (design-system §3.1 rule 1).", "placeholders": {"name": {"type": "String"}}},
  "ceremony.verify.success.done": "Done",
  "@ceremony.verify.success.done": {"description": "S9.3 success action — back to the Members screen."},

  "ceremony.mismatch.title": "Do not proceed.",
  "@ceremony.mismatch.title": {"description": "S9.4 title, from 04 §6.3 🔒 (\"Do not proceed. Contact support.\"). Full red screen, no override."},
  "ceremony.mismatch.body": "The code on that phone does not match the keys we hold for this person. Someone may be standing in for them. Do not give this phone access to your books.",
  "@ceremony.mismatch.body": {"description": "S9.4 body — says plainly what happened and what not to do. There is no override and no retry (04 §6.3 🔒)."},
  "ceremony.mismatch.causes": "It can mean the invitation went to the wrong number, or that someone is trying to get into your books.",
  "@ceremony.mismatch.causes": {"description": "S9.4 — the two honest explanations, from Canvas 4 (S9.4 \"Mismatch · no way past\"). Neither blames the user."},
  "ceremony.mismatch.nothing_shared": "Nothing has been shared. No access was given.",
  "@ceremony.mismatch.nothing_shared": {"description": "S9.4 — Canvas 4 (S9.4). The one reassurance that is true: the ceremony failed before any book key was wrapped (04 §8.2 🔒)."},
  "ceremony.mismatch.next_step": "Do not try again on this phone. Speak to the person face to face first, then call us.",
  "@ceremony.mismatch.next_step": {"description": "S9.4 — Canvas 4 (S9.4). Says plainly that retrying is not the path, without offering a retry control (04 §6.3 🔒)."},
  "ceremony.mismatch.logged": "This has been written to your security log, with the date and who was being verified.",
  "@ceremony.mismatch.logged": {"description": "S9.4 line confirming the verification_mismatch security event (04 §6.3) and the permanent verification log (04 §6.4)."},
  "ceremony.mismatch.support": "Contact support",
  "@ceremony.mismatch.support": {"description": "S9.4 only action, from 04 §6.3 🔒."},
  "ceremony.mismatch.close": "Close",
  "@ceremony.mismatch.close": {"description": "S9.4 way off the screen — back to Members, with the person still unverified. Not an override: nothing is verified and nothing is retried."},
  "ceremony.mismatch.semantics": "Warning. Verification failed.",
  "@ceremony.mismatch.semantics": {"description": "S9.4 icon semantics — the red ground is never the only signal (07 §1 rule 3, design-system §3.1)."}
