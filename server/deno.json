{
  "tasks": {
    "test": "deno test -A --no-check=remote supabase/functions supabase/tests",
    "test:functions": "deno test -A supabase/functions",
    "test:schema": "deno test -A supabase/tests/rls/schema.test.ts",
    "test:rls": "RLS_REQUIRE=1 deno test -A supabase/tests/rls/rls.test.ts",
    "lint": "deno lint supabase/functions supabase/tests && deno fmt --check supabase/functions supabase/tests",
    "fmt": "deno fmt supabase/functions supabase/tests"
  },
  "imports": {
    "sodium": "npm:libsodium-wrappers-sumo@0.7.15",
    "postgres": "npm:postgres@3.4.5",
    "libpg-query": "npm:libpg-query@17.5.2",
    "@std/assert": "jsr:@std/assert@1.0.13",
    "@std/encoding": "jsr:@std/encoding@1.0.10"
  },
  "compilerOptions": { "strict": true, "lib": ["deno.window"] },
  "lint": { "rules": { "tags": ["recommended"], "exclude": ["no-explicit-any"] } },
  "fmt": { "lineWidth": 100, "singleQuote": false }
}
